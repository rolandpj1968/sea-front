#!/bin/sh
# sea-front-cc — wrapper that acts as a C++ compiler for build systems.
#
# Pipeline: preprocess (g++) → transpile (sea-front) → compile C (gcc)
#
# Usage: sea-front-cc [compiler-flags] -c -o output.o input.cpp
#        sea-front-cc [compiler-flags] -o output input.o ...   (link mode)
#
# Environment:
#   SEA_FRONT    — path to sea-front binary (default: build/sea-front)
#   SEA_CC       — C compiler for compiling emitted C (default: cc)
#   SEA_CPP      — C++ preprocessor (default: g++)
#   SEA_VERBOSE  — set to 1 for debug output

set -e

SEA_FRONT="${SEA_FRONT:-$(dirname "$0")/../build/sea-front}"
SEA_CC="${SEA_CC:-cc}"
SEA_CPP="${SEA_CPP:-g++}"
SEA_VERBOSE="${SEA_VERBOSE:-0}"
# Extra flags appended to the cc -c invocation on sea-front's emitted .c.
# Used by wrappers (e.g. scripts/cproc++) to inject back-end-specific
# defines like -D__GNUC__=4 that should NOT also flow to the g++ -E
# preprocessing of the original .cpp (which already defines __GNUC__).
SEA_CC_FLAGS="${SEA_CC_FLAGS:-}"
# Linker flags passed to the final cc link step. Default '-no-pie' matches
# the gcc 4.8 cc1plus/gen-tools-chain need to avoid R_X86_64_32S relocs
# against modern PIE-default host linkers; back-ends that don't accept
# -no-pie (cproc) can override to empty.
SEA_LINK_FLAGS="${SEA_LINK_FLAGS--no-pie}"

log() {
    [ "$SEA_VERBOSE" = "1" ] && echo "[sea-front-cc] $*" >&2 || true
}

# Parse arguments to understand what mode we're in.
# We need to identify:
#   - input files (.cpp, .cc, .cxx, .C, .c)
#   - output file (-o foo)
#   - compile-only (-c)
#   - preprocessor flags (-I, -D, -U, -include, -isystem, -std=)
#   - other flags passed through to the C compiler
MODE="link"
OUTPUT=""
INPUTS=""
CPP_FLAGS=""
CC_FLAGS=""
STD_FLAG=""
SKIP_NEXT=0

for arg in "$@"; do
    if [ "$SKIP_NEXT" = "1" ]; then
        SKIP_NEXT=0
        continue
    fi
    case "$arg" in
        -c)
            MODE="compile"
            ;;
        -o)
            # Next arg is output file — handled in paired loop below
            ;;
        -E|-S|-M|-MM)
            # Preprocessing/assembly/dependency modes — pass through to preprocessor
            exec $SEA_CPP "$@"
            ;;
        -shared|-static)
            CC_FLAGS="$CC_FLAGS $arg"
            ;;
        *)
            ;;
    esac
done

# Shell-quote a single argument so it survives `eval`.
# Wraps in single quotes and escapes any embedded single quotes.
# Required because args like  -DPKGVERSION="(GCC) "  contain spaces
# that would word-split if we accumulated bare strings and re-expanded.
shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Re-parse to extract structured info (output, inputs, flags).
# Each category is a string of shell-quoted args, expanded via `eval`
# at the cpp / cc invocation. Storing bare $arg and re-expanding via
# unquoted "$CPP_FLAGS" word-splits on embedded spaces in -D values.
OUTPUT=""
INPUTS=""
CPP_FLAGS=""
CC_FLAGS=""
PREV=""
for arg in "$@"; do
    if [ "$PREV" = "-o" ]; then
        OUTPUT="$arg"
        PREV=""
        continue
    fi
    if [ "$PREV" = "-MT" ] || [ "$PREV" = "-MF" ]; then
        # Pass the value of -MT/-MF to CPP_FLAGS (the flag itself
        # was already added above).
        CPP_FLAGS="$CPP_FLAGS $(shell_quote "$arg")"
        PREV=""
        continue
    fi
    PREV=""
    qarg=$(shell_quote "$arg")
    case "$arg" in
        -c) MODE="compile" ;;
        -o) PREV="-o" ;;
        -I*|-D*|-U*)
            CPP_FLAGS="$CPP_FLAGS $qarg"
            ;;
        -include|-isystem|-iquote)
            CPP_FLAGS="$CPP_FLAGS $qarg"
            PREV="$arg"
            ;;
        -std=*)
            STD_FLAG="$arg"
            CPP_FLAGS="$CPP_FLAGS $qarg"
            ;;
        -W*|-f*|-g*|-O*|-m*|-pipe|-pthread)
            CC_FLAGS="$CC_FLAGS $qarg"
            ;;
        -l*|-L*)
            CC_FLAGS="$CC_FLAGS $qarg"
            ;;
        -MD|-MMD|-MP)
            # Dependency-generation flags — pass to the preprocess
            # (g++ -E) step only. g++ -E captures all #include
            # relationships and writes the .d file. cc'ing the
            # transpiled .c then doesn't need to redo it. Passing
            # to both would race-and-truncate the same .d file.
            # libcpp's Makefile expects -MF <name>.Tpo to land
            # somewhere — POSTCOMPILE later 'mv'-s it into place.
            CPP_FLAGS="$CPP_FLAGS $qarg"
            ;;
        -MT|-MF)
            # Same as above; pass flag AND its value arg.
            CPP_FLAGS="$CPP_FLAGS $qarg"
            PREV="$arg"
            ;;
        *.cpp|*.cc|*.cxx|*.C|*.c|*.ii|*.i)
            INPUTS="$INPUTS $qarg"
            ;;
        *.o|*.a|*.so)
            # Object/library files — pass through for linking
            CC_FLAGS="$CC_FLAGS $qarg"
            ;;
        *)
            # Unknown — pass to both
            CPP_FLAGS="$CPP_FLAGS $qarg"
            CC_FLAGS="$CC_FLAGS $qarg"
            ;;
    esac
    # Handle -include / -isystem with separate value arg
    case "$PREV" in
        -include|-isystem|-iquote)
            # Will be captured on next iteration as the value
            ;;
    esac
done

# Auto-link libs: sea-front emits ALL inline functions from
# included headers (g++ would drop unused ones). When the host has
# GMP/MPFR/MPC headers reachable via -I (gcc 4.8 ships them in
# build-sf/{gmp,mpfr,mpc}/), the inline wrappers in those headers
# pull __gmpz_*, __gmpn_*, __gmpq_*, __mpfr_* etc. into every .o
# that includes them. Link-time those symbols need to resolve, so
# append -lgmp -lmpfr -lmpc -lm at link time. Use exact .so.N names
# to dodge missing -dev symlinks on minimal hosts.
SEA_AUTO_LIBS=""
for spec in "-l:libgmp.so.10:-lgmp" "-l:libmpfr.so.6:-lmpfr" \
            "-l:libmpc.so.3:-lmpc" "-lm:-lm"; do
    versioned="${spec%:*}"
    fallback="${spec##*:}"
    base=$(echo "$versioned" | sed 's/^-l://')
    if [ -e "/lib/x86_64-linux-gnu/$base" ] || [ -e "/usr/lib/$base" ]; then
        SEA_AUTO_LIBS="$SEA_AUTO_LIBS $versioned"
    elif [ "$versioned" = "-lm" ]; then
        SEA_AUTO_LIBS="$SEA_AUTO_LIBS -lm"
    fi
done

# If no C++ source files, this is a pure link or C compile — pass through
if [ -z "$INPUTS" ]; then
    log "No source files — passthrough to $SEA_CC"
    exec $SEA_CC $SEA_LINK_FLAGS "$@" $SEA_AUTO_LIBS
fi

# Link mode with NO source files (just .o/.a/-l): passthrough to cc.
# Link mode WITH source files (e.g. `sea-front-cc src.cpp -o exe`) is
# the combined-compile-and-link form: compile each source through our
# pipeline to a tmp .o, then link the .o set in a final cc invocation.
# Falling back to passthrough for the combined form silently bypasses
# sea-front, which makes test runs that drive sea-front-cc this way
# (g++.dg dg-do-run, autoconf-style probes) measure the host compiler
# instead of sea-front.
if [ "$MODE" = "link" ] && [ -z "$INPUTS" ]; then
    log "Link mode (no sources) — passthrough to $SEA_CC"
    exec $SEA_CC $SEA_LINK_FLAGS "$@" $SEA_AUTO_LIBS
fi

# Unpack INPUTS (space-separated shell-quoted) into positional params
# so we can iterate without losing args that contain spaces.
eval "set -- $INPUTS"

# Output naming:
#   compile mode (-c, single source, no -o): basename + .o in cwd, to
#     match gcc/g++'s relative-source-but-cwd-output convention used by
#     gcc 4.8's build (e.g. '../../gcc/config/host-linux.c' → 'host-linux.o').
#   link mode (compile-and-link): the per-source .o is a temp file;
#     OUTPUT names the final exe, set via -o or defaulted to a.out.
LINK_OBJS=""
if [ "$MODE" = "compile" ] && [ -z "$OUTPUT" ]; then
    OUTPUT=$(basename "$1" | sed 's/\.[^.]*$/.o/')
fi
if [ "$MODE" = "link" ] && [ -z "$OUTPUT" ]; then
    OUTPUT=a.out
fi

# Compile mode: preprocess → sea-front → cc -c
for src in "$@"; do
    log "Processing: $src"

    TMPDIR="${TMPDIR:-/tmp}"
    base=$(basename "$src" | sed 's/\.[^.]*$//')
    pp_file="$TMPDIR/sf_pp_${base}_$$.i"
    c_file="$TMPDIR/sf_out_${base}_$$.c"

    # Step 1: Preprocess
    #
    # Defines we inject to steer gcc / libc / libcpp away from
    # inline-asm and vectorized code paths that sea-front can't lower:
    #   -DGCC_VERSION=4004
    #       Disables libcpp's SSE2/SSE4 vectorized line scanner
    #       (gated on GCC_VERSION >= 4005) while keeping all other
    #       libcpp feature checks (2007, 3000) enabled. Forces the
    #       scalar search_line_acc_char fallback. sea-front discards
    #       inline asm bodies, so the vectorized fast-path would
    #       compile to an empty function and crash at runtime.
    # mcpp is target-independent and doesn't carry the host gcc's
    # type-token predefines. Reproduce the common Itanium-ABI 64-bit
    # mapping so sources that name '__SIZE_TYPE__' / friends in
    # type positions (e.g. placement-new overloads using
    # 'void* operator new(__SIZE_TYPE__, void*)') still parse.
    # TODO(seafront#predefs): drive these from a platform query
    # instead of hard-coding LP64.
    SF_DEFINES="-DGCC_VERSION=4004"
    SF_DEFINES="$SF_DEFINES -D__SIZE_TYPE__='long unsigned int'"
    SF_DEFINES="$SF_DEFINES -D__PTRDIFF_TYPE__='long int'"
    SF_DEFINES="$SF_DEFINES -D__INTPTR_TYPE__='long int'"
    SF_DEFINES="$SF_DEFINES -D__UINTPTR_TYPE__='long unsigned int'"
    SF_DEFINES="$SF_DEFINES -D__WCHAR_TYPE__=int"
    # Default to C++03 when no -std= flag is given. gcc 4.8 source is
    # C++03; without this, g++ 13 defaults to C++17 and libstdc++ 13
    # headers emit C++17 constructs (std::byte etc.) that sea-front
    # doesn't handle.
    if [ -z "$STD_FLAG" ]; then STD_FLAG="-std=c++03"; fi
    # When SEA_LIBSTDCXX_SRC is set, use -nostdinc++ and point at the
    # target's own libstdc++ headers instead of the host's. Required
    # for bootstrappable builds where the host libstdc++ is a different
    # era (e.g. host is C++17, target is C++03).
    STDCXX_FLAGS=""
    if [ -n "$SEA_LIBSTDCXX_SRC" ] && [ -n "$SEA_LIBSTDCXX_BUILD" ]; then
        STDCXX_FLAGS="-nostdinc++ -I${SEA_LIBSTDCXX_BUILD}/x86_64-unknown-linux-gnu -I${SEA_LIBSTDCXX_BUILD} -I${SEA_LIBSTDCXX_SRC} -I${SEA_LIBSTDCXX_SRC}/c_global"
    fi

    # Use eval so CPP_FLAGS / CC_FLAGS preserve args containing spaces
    # (e.g. -DPKGVERSION="(GCC) "). $src and $pp_file are quoted
    # explicitly inside the eval string.
    qsrc=$(shell_quote "$src")
    qpp=$(shell_quote "$pp_file")
    qcfile=$(shell_quote "$c_file")

    # In compile mode the .o is the deliverable; in link mode it's a
    # temp that gets fed to the final cc link step.
    if [ "$MODE" = "compile" ]; then
        obj_file="$OUTPUT"
    else
        obj_file="$TMPDIR/sf_obj_${base}_$$.o"
        LINK_OBJS="$LINK_OBJS $(shell_quote "$obj_file")"
    fi
    qobj=$(shell_quote "$obj_file")

    log "  Preprocess: $SEA_CPP -E $SF_DEFINES $STD_FLAG $STDCXX_FLAGS $CPP_FLAGS $src"
    eval "$SEA_CPP -E $SF_DEFINES $STD_FLAG $STDCXX_FLAGS $CPP_FLAGS $qsrc -o $qpp" 2>/dev/null

    # Step 2: Transpile C++ → C
    # SEA_FRONT_FLAGS lets callers pass through extra flags (e.g.
    # --mangling=human to revert to the pre-Itanium scheme).
    # Stderr is captured to a tempfile so warnings stay silent on
    # success but real errors (non-zero exit) surface to the caller.
    sf_err="$TMPDIR/sf_err_${base}_$$.log"
    log "  Transpile: $SEA_FRONT --emit-c ${SEA_FRONT_FLAGS:-} $pp_file"
    if ! eval "$SEA_FRONT --emit-c ${SEA_FRONT_FLAGS:-} $qpp > $qcfile 2> $(shell_quote "$sf_err")"; then
        cat "$sf_err" >&2
        rm -f "$sf_err"
        exit 1
    fi
    rm -f "$sf_err"

    # Step 3: Compile C → .o
    # Use -std=c11 — sea-front emits u8"..." string-prefixes verbatim
    # (C11 §6.4.5) and _Thread_local in the EH lowering (C11 §6.7.1).
    log "  Compile: $SEA_CC -std=c11 -c $SEA_CC_FLAGS $CC_FLAGS -o $obj_file $c_file"
    eval "$SEA_CC -std=c11 -c $SEA_CC_FLAGS $CC_FLAGS -o $qobj $qcfile"

    # Cleanup (skip when SEA_KEEP_TMP is set, for debugging)
    if [ -z "$SEA_KEEP_TMP" ]; then
        rm -f "$pp_file" "$c_file"
    fi
done

# Link mode: link the produced .o files (plus any .o/.a/-l args from
# CC_FLAGS) into the final binary. The host C linker is fine — sea-front
# emits C, and Itanium-mangled symbols are just C identifiers at this
# point.
if [ "$MODE" = "link" ]; then
    qout=$(shell_quote "$OUTPUT")
    log "  Link: $SEA_CC $SEA_LINK_FLAGS $LINK_OBJS $CC_FLAGS -o $OUTPUT $SEA_AUTO_LIBS"
    eval "$SEA_CC $SEA_LINK_FLAGS $LINK_OBJS $CC_FLAGS -o $qout $SEA_AUTO_LIBS"
    if [ -z "$SEA_KEEP_TMP" ]; then
        eval "rm -f $LINK_OBJS"
    fi
fi

log "Done"
